{
  "name": "patchbay",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @patchbay/web dev",
    "web:build": "pnpm --filter @patchbay/web build",
    "web:typecheck": "pnpm --filter @patchbay/web typecheck",
    "db:up": "docker compose up -d postgres",
    "db:local": "node scripts/setup/local-postgres.mjs",
    "db:migrate": "pnpm --filter @patchbay/web db:migrate",
    "agent:test": "go test ./agent/...",
    "agent:build": "mkdir -p agent/bin && go build -trimpath -o agent/bin/patchbay-agent ./agent/cmd/patchbay-agent",
    "agent:run": "go run ./agent/cmd/patchbay-agent",
    "env:local": "node scripts/setup/create-local-env.mjs",
    "env:set-gemini": "node scripts/setup/set-gemini-key.mjs",
    "test:secrets": "node scripts/checks/secret-guard.mjs",
    "test:env": "node scripts/checks/env-template.mjs",
    "test:env:local": "node scripts/checks/local-env-generator.mjs",
    "test:compose": "node scripts/checks/compose-security.mjs",
    "test:docker": "node scripts/checks/docker-build-contract.mjs",
    "test:schema": "node scripts/checks/schema-constraints.mjs",
    "test:migrations": "pnpm --filter @patchbay/web test:migrations",
    "test:auth-readiness": "pnpm --filter @patchbay/web test:auth-readiness",
    "test:investigation-plan": "pnpm --filter @patchbay/web test:investigation-plan",
    "test:auth-readiness:integration": "node scripts/integration/auth-readiness.mjs",
    "test:auth-misconfiguration": "node scripts/integration/auth-misconfiguration.mjs",
    "test:ui": "node scripts/integration/ui-smoke.mjs",
    "test:integration": "node scripts/integration/smoke.mjs",
    "test:task-scheduler": "node scripts/integration/task-scheduler.mjs",
    "test:agent-lease": "node scripts/integration/agent-lease.mjs",
    "test:investigation": "node scripts/integration/investigation.mjs",
    "test:two-agent-investigation": "node scripts/integration/two-agent-investigation.mjs",
    "test:investigation-dag": "pnpm --filter @patchbay/web test:investigation-dag",
    "test:investigation-evidence": "pnpm --filter @patchbay/web test:investigation-evidence",
    "test:integration:postgres": "PATCHBAY_INTEGRATION_STORAGE=postgres node scripts/integration/smoke.mjs",
    "test:postgres:schema": "pnpm --filter @patchbay/web exec node scripts/postgres-schema-smoke.mjs",
    "test:task-timeout": "node scripts/integration/task-timeout.mjs",
    "test:task-timeout:postgres": "PATCHBAY_TASK_TIMEOUT_STORAGE=postgres node scripts/integration/task-timeout.mjs",
    "test:artifact-retention": "node scripts/integration/artifact-retention.mjs",
    "test:artifact-retention:postgres": "PATCHBAY_ARTIFACT_RETENTION_STORAGE=postgres node scripts/integration/artifact-retention.mjs",
    "test:llm:fallback": "node scripts/integration/llm-fallback.mjs",
    "test:gemini:fake": "node scripts/integration/gemini-fake.mjs",
    "test:planner:gemini:fake": "node scripts/integration/planner-gemini-fake.mjs",
    "test:tailscale:fake": "node scripts/integration/tailscale-fake.mjs",
    "test:gemini:live": "node scripts/integration/live-gemini.mjs",
    "test:tailscale:live": "node scripts/integration/live-tailscale.mjs",
    "check": "pnpm test:secrets && pnpm test:env && pnpm test:env:local && pnpm test:compose && pnpm test:docker && pnpm test:schema && pnpm test:migrations && pnpm test:auth-readiness && pnpm test:investigation-plan && pnpm test:investigation-dag && pnpm test:investigation-evidence && pnpm web:typecheck && pnpm web:build && pnpm test:auth-readiness:integration && pnpm test:auth-misconfiguration && pnpm test:ui && pnpm agent:test && pnpm agent:build && pnpm test:integration && pnpm test:task-scheduler && pnpm test:agent-lease && pnpm test:investigation && pnpm test:two-agent-investigation && pnpm test:task-timeout && pnpm test:artifact-retention && pnpm test:llm:fallback && pnpm test:planner:gemini:fake && pnpm test:gemini:fake && pnpm test:tailscale:fake"
  }
}
